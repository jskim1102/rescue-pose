# 선택 사항입니다. ./dev.sh는 루트 .env를 읽고 이 프로그램의 MediaMTX에 연결합니다.
# 개발용 백엔드 설정을 바꾸려면 이 파일을 backend/.env로 복사하세요.

# 허용할 프런트엔드 주소입니다. 기본값 *는 모든 주소를 허용합니다.
CORS_ORIGINS=*

# 등록할 수 있는 카메라의 최대 대수입니다 (1~2, 기본 2).
MAX_IPCAMS=2

# 이 프로그램의 MediaMTX에 등록하는 카메라 경로의 접두사와 제어용 계정입니다.
MEDIAMTX_PATH_PREFIX=rescue_pose
MEDIAMTX_BACKEND_USER=backend

# 공식 YOLO 모델 저장 폴더입니다. 비우면 backend/models이며 상대 경로는 backend 기준입니다.
YOLO_WEIGHTS_DIR=

# 누운 자세가 이 시간(초) 이상 이어지면 구조가 필요한 사람으로 표시합니다 (기본 10).
RESCUE_LYING_THRESHOLD_S=10

# 사람이 이 시간(초)보다 오래 감지되지 않으면 그 사람의 누운 시간을 처음부터 다시 셉니다 (기본 3).
RESCUE_EXPIRY_S=3

# 백엔드 로그 수준입니다.
LOG_LEVEL=INFO
