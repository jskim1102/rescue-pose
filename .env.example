# rescue-pose 설정 예시. 설치 스크립트가 이 파일로 .env를 만듭니다.

# ── 포트 ──
# 비워 두면 설치할 때 이 PC에서 사용 가능한 포트를 고릅니다.
BACKEND_PORT=
FRONTEND_PORT=

# ── mediamtx ──
# API와 RTSP 주소는 컨테이너 사이에서 사용합니다. 아래 포트 네 개는 설치할 때 채웁니다.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_API_PORT=
MEDIAMTX_RTSP_PORT=
MEDIAMTX_WEBRTC_PORT=
MEDIAMTX_ICE_UDP_PORT=
MEDIAMTX_RTSP_BASE_URL=rtsp://mediamtx:8554
MEDIAMTX_PATH_PREFIX=rescue_pose
# 묻기: 다른 PC나 휴대폰에서도 영상을 보려면 이 PC의 IP 주소를 입력하세요. 이 PC에서만 보면 Enter를 누르세요.
MEDIAMTX_WEBRTC_HOST=
# backend는 제어·송출용, viewer는 시청용입니다. 빈 비밀번호는 설치할 때 각각 생성합니다.
MEDIAMTX_BACKEND_USER=backend
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rescue_pose
MEDIAMTX_VIEWER_PASS=

# ── 추론 (YOLO) ──
# YOLO_DEVICE 빈값 = GPU 자동 감지, 없으면 CPU
YOLO_DEFAULT_MODEL=yolo26n-pose.pt
YOLO_CONF_THRESHOLD=0.5
YOLO_DEVICE=

# ── 카메라 및 브라우저 접속 ──
# 등록할 수 있는 카메라 수입니다. 1대 또는 2대이며 기본값은 2대입니다.
MAX_IPCAMS=2
# 브라우저에서 API 호출을 허용할 출처를 쉼표로 구분합니다. *는 모든 출처를 허용합니다.
CORS_ORIGINS=*
